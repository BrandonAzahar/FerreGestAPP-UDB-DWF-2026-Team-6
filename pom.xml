<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        FerreGest - Sprint 2 (Fase 2)
        Migración de la arquitectura Servlet/JSP + JDBC hacia JSF + AJAX + JPA/Hibernate.

        NOTA SOBRE EL NAMESPACE:
        Se usa el namespace "javax.*" (JSF 2.3, JPA 2.2, Servlet 4.0) porque el servidor
        objetivo es Apache Tomcat 8.5/9.0 (el que trae XAMPP). Si en el futuro se migra a
        Tomcat 10+, habría que cambiar a "jakarta.*" (Jakarta Faces 3/4, Hibernate 6).
    -->

    <modelVersion>4.0.0</modelVersion>

    <groupId>com.ferregest</groupId>
    <artifactId>ferregest-webapp</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <failOnMissingWebXml>false</failOnMissingWebXml>

        <!-- Versiones centralizadas de las dependencias principales -->
        <hibernate.version>5.6.15.Final</hibernate.version>
        <mojarra.version>2.3.9</mojarra.version>
        <mysql.version>8.3.0</mysql.version>
        <weld.version>3.1.9.Final</weld.version>
    </properties>

    <dependencies>

        <!-- Servlet API 4.0 (Provided por Apache Tomcat 8.5/9.0) -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>4.0.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSP API (se conserva para las vistas JSP originales del Sprint 1) -->
        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>javax.servlet.jsp-api</artifactId>
            <version>2.3.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL para soporte de vistas JSP/JSTL (módulo heredado del Sprint 1) -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
            <version>1.2</version>
        </dependency>

        <!-- Conector MySQL Oficial -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
        </dependency>

        <!-- JavaServer Faces (JSF 2.3 - Mojarra Implementation) -->
        <dependency>
            <groupId>org.glassfish</groupId>
            <artifactId>javax.faces</artifactId>
            <version>${mojarra.version}</version>
        </dependency>

        <!-- JPA 2.2 API (Java Persistence API) -->
        <dependency>
            <groupId>javax.persistence</groupId>
            <artifactId>javax.persistence-api</artifactId>
            <version>2.2</version>
        </dependency>

        <!-- Hibernate Core (Proveedor de persistencia JPA) -->
        <dependency>
            <groupId>org.hibernate</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.version}</version>
        </dependency>

        <!-- CDI API para Managed Beans (@Named, @ViewScoped) -->
        <dependency>
            <groupId>javax.enterprise</groupId>
            <artifactId>cdi-api</artifactId>
            <version>2.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- Anotaciones estándar (@PostConstruct, @PreDestroy) -->
        <dependency>
            <groupId>javax.annotation</groupId>
            <artifactId>javax.annotation-api</artifactId>
            <version>1.3.2</version>
        </dependency>

        <!-- Weld Servlet (Contenedor CDI para Apache Tomcat, que no trae CDI de fábrica) -->
        <dependency>
            <groupId>org.jboss.weld.servlet</groupId>
            <artifactId>weld-servlet-shaded</artifactId>
            <version>${weld.version}</version>
        </dependency>
        
        <!-- ========================================== -->
        <!-- DEPENDENCIAS PARA LA FASE 3 (API REST)     -->
       
        
        <!-- JAX-RS API (Para crear los endpoints REST) -->
        <dependency>
            <groupId>javax.ws.rs</groupId>
            <artifactId>javax.ws.rs-api</artifactId>
            <version>2.1.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Jersey (La implementación de JAX-RS para Tomcat) -->
        <dependency>
            <groupId>org.glassfish.jersey.containers</groupId>
            <artifactId>jersey-container-servlet</artifactId>
            <version>2.35</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jersey.inject</groupId>
            <artifactId>jersey-hk2</artifactId>
            <version>2.35</version>
        </dependency>

        <!-- Jackson (Para que Jersey devuelva y reciba JSON automáticamente) -->
        <dependency>
            <groupId>org.glassfish.jersey.media</groupId>
            <artifactId>jersey-media-json-jackson</artifactId>
            <version>2.35</version>
        </dependency>

    </dependencies>

    <build>
        <finalName>ferregest</finalName>

        <plugins>
            <!-- Compilador de Java configurado para Java 17 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>17</release>
                    <encoding>UTF-8</encoding>
                </configuration>
            </plugin>

            <!-- Plugin para empaquetar en archivo WAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
        </plugins>
    </build>

</project>